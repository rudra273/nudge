# --- Telegram (required) ---------------------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Chat ids allowed to use the bot and receive alerts (comma-separated).
# Don't know yours? Start `nudge run`, message your bot, and it replies with your chat id.
TELEGRAM_CHAT_ID=

# --- AI (optional; Nudge works fully without it) -----------------------------------
# Set ONE key and it is picked up automatically:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
#
# Or choose explicitly (openai | gemini | anthropic | ollama | openrouter | groq):
# NUDGE_LLM_PROVIDER=ollama
# NUDGE_LLM_MODEL=llama3.1
# NUDGE_LLM_BASE_URL=http://localhost:11434/v1     # any OpenAI-compatible endpoint
# NUDGE_LLM_API_KEY=
# NUDGE_LLM=off                                     # force AI off even if a key is set

# --- Fetching -------------------------------------------------------------------------
# NUDGE_BROWSER=1               # render pages in headless Chromium (pip install "nudge-bot[browser]")
# NUDGE_BROWSER_PATH=/usr/bin/chromium   # use an existing Chrome/Chromium for browser mode
# NUDGE_TIMEOUT=20
# NUDGE_USER_AGENT=...

# --- Storage & behaviour ----------------------------------------------------------------
# NUDGE_WATCHES=watches.yaml
# NUDGE_STATE=.nudge-state.json
# NUDGE_TICK=30                 # seconds between scheduler ticks in `nudge run`
# NUDGE_DEFAULT_INTERVAL=15m
# NUDGE_PLUGINS=my_checkers     # comma-separated modules that register extra checkers
