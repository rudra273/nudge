# Telegram: create a bot with @BotFather, then message it and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to control the bot and receive alerts.
TELEGRAM_CHAT_ID=

# Optional: smarter natural-language parsing with Claude (pip install "nudge-bot[llm]").
# NUDGE_LLM=auto turns it on whenever ANTHROPIC_API_KEY is set; set NUDGE_LLM=off to disable.
ANTHROPIC_API_KEY=
# NUDGE_LLM_MODEL=claude-opus-5-5

# Storage
# NUDGE_WATCHES=watches.yaml
# NUDGE_STATE=.nudge-state.json

# Behaviour
# NUDGE_TICK=30                 # seconds between scheduler ticks in `nudge run`
# NUDGE_DEFAULT_INTERVAL=15m
# NUDGE_TIMEOUT=20
# NUDGE_USER_AGENT=...
# NUDGE_PLUGINS=my_checkers     # comma-separated modules that register extra checkers
